+/// Cell borders from the TC80s after the edges in a `sprmTDefTable` operand: per cell tcgrf (2
+/// bytes) and wWidth (2), then brcTop, brcLeft, brcBottom and brcRight as Brc80MayBeNil. A zero
+/// Brc80 states no border for its side, which then follows the table's borders; a cell that
+/// states none is `None`.
+fn def_table_borders(operand: &[u8]) -> Vec<Option<Borders>> {
+    let itc = operand.get(2).copied().unwrap_or(0) as usize;
+    let start = 3 + (itc + 1) * 2;
+    let mut out = Vec::with_capacity(itc.min(MAX_COLS));
+    for i in 0..itc.min(MAX_COLS) {
+        let Some(tc) = operand.get(start + i * 20..start + i * 20 + 20) else { break };
+        let side = |k: usize| {
+            let b = &tc[4 + k * 4..8 + k * 4];
+            if b.iter().all(|x| *x == 0) { None } else { fmt::brc80(b) }
+        };
+        let b = Borders { top: side(0), left: side(1), bottom: side(2), right: side(3), ..Default::default() };
+        out.push((b.top.is_some() || b.left.is_some() || b.bottom.is_some() || b.right.is_some()).then_some(b));
